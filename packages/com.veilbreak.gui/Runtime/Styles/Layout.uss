/* Screen layout for a portrait board at the 390 × 844 reference: rows and grids, Navigator screens and pages,
   sections, dialogs, backdrops and the root's responsive classes. Components style themselves in Gui.uss. */

/* ── structure ─────────────────────────────────────────────────────────── */
.vb-root { flex-grow: 1; }
.vb-grow { flex-grow: 1; }
.vb-row { flex-direction: row; align-items: center; }
.vb-row--between { justify-content: space-between; }
.vb-row--wrap { flex-wrap: wrap; }
.vb-half { flex-grow: 1; flex-basis: 0; margin: 0 5px; }
/* Four across (squad slots, roster tiles, result cards); wrap for longer lists. */
.vb-grid4 { flex-direction: row; justify-content: space-between; }
.vb-grid4--wrap { flex-wrap: wrap; }
.vb-grid4--wrap > * { margin-bottom: 10px; }
.vb-grid4 > .vb-tile, .vb-grid4 > .vb-slot { width: 23%; }
/* Generic grid: 2, 3 or 4 across (GridLayout); cells keep their row rhythm with --wrap. */
.vb-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.vb-grid--2 > * { width: 48.5%; }
.vb-grid--3 > * { width: 31.5%; }
.vb-grid--4 > * { width: 23%; }
.vb-grid--wrap > * { margin-bottom: 10px; }
/* Two columns; end cells align right. */
.vb-grid2 { flex-direction: row; flex-wrap: wrap; }
.vb-grid2__cell { width: 50%; flex-direction: row; }
.vb-grid2__cell--end { justify-content: flex-end; }

/* ── Navigator screens and pages ───────────────────────────────────────── */
/* The screen layer covers the board inside the safe area (SafeAreaRoot insets it); pages fill it. */
.vb-screen { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(5, 2, 8, 0.86); }
.vb-page { flex-grow: 1; padding: 0 16px 8px 16px; }
.vb-page > .vb-button { flex-shrink: 0; }
/* Pages under a ScreenHeader: the header spans the board, content keeps a 12-unit gutter. */
.vb-page--headed { padding-left: 0; padding-right: 0; }
.vb-page--headed > * { margin-left: 12px; margin-right: 12px; }
.vb-page--headed > .vb-header { margin-left: 0; margin-right: 0; }
/* Vertical margins only: a shorthand here would reset the headed page's side margins (labels sat on the board edge). */
.vb-page__label { margin-top: 8px; margin-bottom: 6px; }
.vb-page__caption { margin-top: 4px; margin-bottom: 10px; }
.vb-page__footer { margin-top: 8px; -unity-text-align: middle-center; color: var(--vb-color-text-3); }
.vb-page__scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }

/* ── sections and dialogs ──────────────────────────────────────────────── */
.vb-section { margin-bottom: 12px; padding: 12px 14px; }
.vb-section > .vb-t-label { margin-bottom: 4px; height: 18px; }
.vb-section > .vb-slider { height: 54px; min-height: 54px; flex-shrink: 0; }
.vb-section > .vb-switch { min-height: 62px; flex-shrink: 0; }
.vb-section .vb-segmented { margin-bottom: 8px; }
.vb-dialog { padding: 16px; flex-shrink: 0; }
.vb-dialog > * { margin-bottom: 12px; }
.vb-dialog .vb-button--secondary, .vb-dialog .vb-button--danger { align-self: flex-start; min-height: 48px; }

/* ── ActionRow: buttons that fill the row ──────────────────────────────── */
/* Every child takes an equal share with 8 between (the first child is marked vb-action-row__first); the row stacks into a column when the
   shares would fall under MinItemWidth. --fixed keeps one fixed width for trailing actions (BUY, SELL). */
.vb-action-row { flex-direction: row; align-items: stretch; flex-shrink: 0; }
.vb-action-row > * { flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-width: 0; margin-left: 8px; align-self: stretch; }
.vb-action-row > .vb-button { padding-left: 12px; padding-right: 12px; }
.vb-action-row > .vb-action-row__first { margin-left: 0; }
.vb-action-row--stacked { flex-direction: column; }
.vb-action-row--stacked > * { flex-grow: 0; flex-basis: auto; margin-left: 0; margin-top: 8px; }
.vb-action-row--stacked > .vb-action-row__first { margin-top: 0; }
.vb-action-row--fixed { align-items: center; }
.vb-action-row--fixed > * { flex-grow: 0; flex-shrink: 0; flex-basis: auto; width: 92px; align-self: center; }

/* ── backdrop ──────────────────────────────────────────────────────────── */
.vb-backdrop { position: absolute; left: 0; right: 0; top: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; -unity-background-image-tint-color: rgb(215, 215, 215); }
.vb-backdrop__shade { position: absolute; left: 0; right: 0; bottom: 0; height: 36%; --vb-cut: 0; --vb-bw: 0; --vb-fill: rgba(0, 0, 0, 0.01); --vb-fill-to: rgba(0, 0, 0, 0.94); --vb-fill-dir: 90; }

/* ── root classes (SafeAreaRoot.Flags) ─────────────────────────────────── */
.vb-large-text .vb-t-body { font-size: 15px; }
.vb-large-text .vb-t-caption { font-size: 13px; }

/* ── stack, list and board (StackLayout, ListLayout, BoardLayout) ─────── */
/* A column with one rhythm: every child but the last gets the gap underneath (StackLayout marks the last child). */
.vb-stack { flex-direction: column; flex-shrink: 0; }
.vb-stack--4 > * { margin-bottom: 4px; }
.vb-stack--8 > * { margin-bottom: 8px; }
.vb-stack--12 > * { margin-bottom: 12px; }
.vb-stack--16 > * { margin-bottom: 16px; }
.vb-stack > .vb-stack__last { margin-bottom: 0; }
/* Rows of one kind with 6 between them; the empty line shows while there are none. */
.vb-list { flex-direction: column; }
.vb-list > * { margin-bottom: 6px; flex-shrink: 0; }
.vb-list__empty { margin: 8px 0; color: var(--vb-color-text-3); }
.vb-list-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
/* The battle board: top and bottom never shrink, the world takes the rest. */
.vb-board { flex-grow: 1; flex-direction: column; }
.vb-board__top { flex-shrink: 0; }
.vb-board__world { flex-grow: 1; position: relative; overflow: hidden; }
.vb-board__bottom { flex-shrink: 0; padding-bottom: 6px; }

/* ── slim containers ───────────────────────────────────────────────────── */
/* Containers read as quiet tonal planes (cut-xs, no edge); the chipped look is left for what you act on or what is selected. */
.vb-section, .vb-dialog, .vb-details, .vb-score, .vb-perk-row, .vb-rule, .vb-result, .vb-queue__row, .vb-merchant__exchange { --vb-cut: 4; --vb-bw: 0; }
/* States that are selections or warnings keep an edge. */
.vb-score--current, .vb-perk-row--selected, .vb-rule--warning, .vb-rule--draft { --vb-bw: 1; }
.vb-contrast .vb-section, .vb-contrast .vb-dialog, .vb-contrast .vb-details, .vb-contrast .vb-score, .vb-contrast .vb-perk-row,
.vb-contrast .vb-rule, .vb-contrast .vb-result, .vb-contrast .vb-queue__row, .vb-contrast .vb-merchant__exchange { --vb-bw: 1; --vb-edge: var(--vb-color-line-strong); }
.vb-contrast .vb-score--current, .vb-contrast .vb-perk-row--selected { --vb-edge: var(--vb-color-ally); }
.vb-contrast .vb-rule--warning { --vb-edge: var(--vb-color-warn); }
/* Nested surfaces (the border rule in Gui.uss): high contrast gives every one its edge back. */
/* nest:contrast:begin */
.vb-contrast .vb-nest, .vb-contrast .vb-tile, .vb-contrast .vb-slot, .vb-contrast .vb-operative .vb-skill, .vb-contrast .vb-queue-chip,
.vb-contrast .vb-queue__row, .vb-contrast .vb-hud__resources, .vb-contrast .vb-chip-row__plate, .vb-contrast .vb-stat-row--plated, .vb-contrast .vb-perk-detail__thumb,
.vb-contrast .vb-perk-row__thumb, .vb-contrast .vb-contribution__portrait, .vb-contrast .vb-details__skill-icon, .vb-contrast .vb-details__close,
.vb-contrast .vb-result, .vb-contrast .vb-status, .vb-contrast .vb-effect--ready, .vb-contrast .vb-popover .vb-button--secondary,
.vb-contrast .vb-dialog .vb-button--secondary, .vb-contrast .vb-drawer__sheet .vb-button--secondary, .vb-contrast .vb-section .vb-button--secondary { --vb-bw: 1; --vb-edge: var(--vb-color-line-strong); }
/* nest:contrast:end */
/* A focus ring keeps its own colour and weight. */
.vb-contrast .vb-tile--focused, .vb-contrast .vb-tile--focused:hover { --vb-bw: 2; --vb-edge: var(--vb-color-ally); }
