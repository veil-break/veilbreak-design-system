/* The AR HUD kit (HudKit; design-system/README.md): board-unit layout for HudStage, the HudShape reset and focus rings, glass
   panels and presses, the CTA, rail, icon buttons, switch, segment, bar, tiles, chips, helpers and the HudFx effect layers.
   Colours come from the design tokens (--vb-color-*, VeilbreakTokens.uss in Veilbreak). The kit sets no typefaces: the app adds
   its face rules (-unity-font) for these classes in a sheet after this one (Veilbreak: VeilbreakBoards.uss). Attach it per screen
   (a UXML <Style>), after the app's own base sheet and before its screen sheets: .ar-shape must outrank element-level button rules. */
.disp { -unity-font-style: normal; letter-spacing: 2px; }
.stage { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.board { position: absolute; left: 0; top: 0; }
.ar-shape { background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; margin: 0; padding: 0; --cut: 10; --stroke-width: 1; --flip: 0; --fill-to: rgba(0, 0, 0, 0); --fill-dir: 0; --bracket-2: rgba(0, 0, 0, 0); --bracket-mask: 0; --bracket-len: 8; --bracket-w: 2; --bracket-out: 3; --ring: rgba(0, 0, 0, 0); --ring-gap: rgba(0, 0, 0, 0);
       --bracket: rgba(0, 0, 0, 0); --glow: rgba(0, 0, 0, 0); --sheen: rgba(0, 0, 0, 0); --scan: rgba(0, 0, 0, 0); --halo: rgba(0, 0, 0, 0); --scan-pitch: 3; }
/* The default theme paints buttons on hover/press/focus; a shape paints itself. */
.ar-shape:hover, .ar-shape:active, .ar-shape:focus, .ar-shape:disabled { background-color: rgba(0, 0, 0, 0); border-color: rgba(0, 0, 0, 0); }
/* Keyboard focus (HudNavigation sets .kbd on the screen after keyboard or gamepad input, never for mouse or touch): a 2px focus frame after a 2px ground gap, painted by HudShape;
   segments (clipped) and native fields take an inset frame instead. .no-ring opts out for elements whose selected look already is the focus mark. */
.kbd .ar-shape:focus { --ring: var(--vb-color-focus); --ring-gap: var(--vb-color-ground); }
.kbd .no-ring:focus { --ring: rgba(0, 0, 0, 0); }
.kbd .seg:focus { border-width: 2px; border-color: var(--vb-color-focus); }
.kbd .seg.on:focus { border-color: var(--vb-color-focus); }
.unity-base-text-field__input:focus { border-color: var(--vb-color-teal-500); }
.kbd .unity-base-popup-field:focus .unity-base-field__input, .kbd .unity-base-popup-field .unity-base-field__input:focus { border-width: 2px; border-color: var(--vb-color-focus); }
.kbd .unity-toggle:focus .unity-toggle__checkmark { border-width: 2px; border-color: var(--vb-color-focus); }
.kbd .unity-base-slider:focus .unity-base-slider__dragger { border-width: 2px; border-color: var(--vb-color-focus); }
/* Panels are solid plum with a hairline frame (the original screen designs) under a faint layer of holo glass: a cyan top light,
   scanlines, projector bleed along the frame and cyan brackets on the square corners. Buttons are glass too and take a cyan frame on hover. */
.pnl { --fill: var(--vb-color-panel); --stroke: var(--vb-color-line); --sheen: var(--vb-color-glass-sheen); --scan: var(--vb-color-scan); --halo: var(--vb-color-halo);
       --bracket: var(--vb-color-holo-frame); --bracket-len: 9; --bracket-w: 1.2; --bracket-out: 0; }
.press { --fill: var(--vb-color-panel); --stroke: var(--vb-color-line); --sheen: var(--vb-color-glass-sheen); color: var(--vb-color-text); transition-property: scale; transition-duration: 0.22s; transition-timing-function: ease-out; }
.press:hover { --stroke: var(--vb-color-holo-frame); --halo: var(--vb-color-halo); }
.press:active { scale: 0.96 0.96; }
.press:disabled { opacity: 0.45; }
.reduced .press { transition-property: opacity; }
.reduced .press:active { scale: 1 1; opacity: 0.8; }
.tag { position: absolute; font-size: 10px; letter-spacing: 1px; text-shadow: 0 1px 3px rgb(0, 0, 0); -unity-text-align: middle-center; translate: -50% 0; white-space: nowrap; }
.tag-dim { opacity: 0.3; }
.shadow { text-shadow: 0 1px 2px rgb(0, 0, 0); }
.label-caps { font-size: 10px; letter-spacing: 2.2px; color: var(--vb-color-text-2); }
/* A panel header (TACTICAL, TARGET): readout caps in the mono face, a rule after it. */
.readout { letter-spacing: 1px; }
.holo { color: var(--vb-color-holo); }
.ui { font-size: 13px; }
.ui-sm { font-size: 11px; color: var(--vb-color-text-2); white-space: normal; }

.cta { --fill: var(--vb-color-cta); --fill-to: rgb(212, 247, 234); --fill-dir: 0; --stroke: var(--vb-color-cta-2); --glow: rgba(29, 217, 160, 0.35); --sheen: rgba(255, 255, 255, 0.18); --halo: rgba(29, 217, 160, 0.25); --neon: var(--vb-color-cta-2); --cut: 14; color: var(--vb-color-on-cta); align-items: flex-start; justify-content: center; padding-left: 20px; padding-right: 20px; }
.cta:hover { --fill: rgb(78, 228, 178); --fill-to: rgb(230, 252, 243); }
.cta-title { font-size: 24px; letter-spacing: 3px; color: var(--vb-color-on-cta); -unity-text-align: middle-left; }
.cta-sub { font-size: 11px; color: var(--vb-color-on-cta); }
.cta.center { align-items: center; }

.rail { width: 72px; height: 56px; align-items: center; justify-content: center; }
.rail-label { font-size: 10px; letter-spacing: 1.4px; margin-top: 3px; }
.badge-new { position: absolute; right: 8px; top: 8px; color: var(--vb-color-badge-new); }
/* --icon marks the icon for HudIcon: UI Toolkit raises CustomStyleResolvedEvent, where a glyph takes its tint, only for an element
   with custom properties of its own. */
.icon { color: var(--vb-color-text); flex-shrink: 0; --icon: 1; }
.icon-button { width: 48px; height: 48px; align-items: center; justify-content: center; }

.switch { flex-direction: row; align-items: center; justify-content: center; height: 48px; padding-left: 12px; padding-right: 12px; }
.knob { width: 36px; height: 20px; background-color: rgba(250, 238, 244, 0.2); margin-right: 10px; justify-content: center; padding: 3px; }
.knob-dot { width: 14px; height: 14px; background-color: var(--vb-color-text); }
.switch.on .knob { background-color: var(--vb-color-teal-500); align-items: flex-end; }
.switch.on .knob-dot { background-color: var(--vb-color-dark-100); }
.switch-label { font-size: 11px; letter-spacing: 1.6px; }

.segment { flex-direction: row; overflow: hidden; }
.seg { flex-grow: 1; flex-basis: 0; height: 44px; margin: 0; border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0); color: rgba(250, 238, 244, 0.85); align-items: center; justify-content: center; padding: 0 4px; }
.seg:hover { background-color: rgba(250, 238, 244, 0.08); }
.seg.on { background-color: var(--vb-color-text); color: var(--vb-color-on-cta); }
.seg-title { font-size: 11px; letter-spacing: 1.6px; }
.seg-sub { font-size: 10px; }
.seg.on .seg-title, .seg.on .seg-sub { color: var(--vb-color-on-cta); }
.segment.tall .seg { height: 48px; }

.bar { height: 4px; background-color: rgba(250, 238, 244, 0.1); border-left-width: 1px; border-right-width: 1px; border-color: rgba(250, 238, 244, 0.35); }
.bar-fill { height: 100%; background-color: var(--vb-color-teal-500); }
.bar.rank .bar-fill { background-color: var(--vb-color-lavender-500); }

.tile { width: 76px; height: 52px; --cut: 6; align-items: center; justify-content: center; --fill: var(--vb-color-panel); --stroke: var(--vb-color-line); }
.tile.in { --fill: rgba(13, 48, 40, 0.9); --stroke: rgba(29, 217, 160, 0.7); }
.tile.sel { --stroke: var(--vb-color-teal-500); --stroke-width: 2; --glow: rgba(29, 217, 160, 0.3); }
.tile-mono { font-size: 14px; }
.tile-name { font-size: 10px; letter-spacing: 1px; }
.tile.in .tile-name { color: var(--vb-color-teal-300); }
.chip { --cut: 6; }
.ghost { --fill: rgba(250, 238, 244, 0.06); --stroke: var(--vb-color-holo-frame); --cut: 6; }
.violet { --fill: rgba(192, 132, 252, 0.22); --stroke: var(--vb-color-lavender-500); }
.danger { --fill: rgba(240, 80, 154, 0.18); --stroke: var(--vb-color-crimson-400); --neon: var(--vb-color-crimson-400); }
.small-cta { height: 44px; padding: 0 12px; justify-content: center; align-items: center; }
.small-cta .ui { font-size: 11px; letter-spacing: 1.6px; }
.layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.modal-scrim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(2, 5, 8, 0.72); }
.row { flex-direction: row; align-items: center; }
.col { flex-direction: column; }
.grow { flex-grow: 1; }
.spread { flex-direction: row; justify-content: space-between; align-items: center; }
.teal { color: var(--vb-color-teal-300); }
.lilac { color: var(--vb-color-lavender-300); }
.rose { color: var(--vb-color-crimson-300); }
.muted2 { color: var(--vb-color-text-2); }
.rule { height: 1px; background-color: var(--vb-color-line); margin: 6px 0; }

/* HudFx layers (sheen, halo, sparks, flash, glitch-in, slam) */
.fx-clip { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; }
.fx-sheen { position: absolute; top: -60%; bottom: -60%; width: 30%; left: -60%; rotate: 20deg; opacity: 0.42; -unity-background-scale-mode: stretch-to-fill; }
.fx-halo { position: absolute; opacity: 0; -unity-background-scale-mode: stretch-to-fill; }
.fx-spark { position: absolute; width: 8px; height: 8px; -unity-background-scale-mode: stretch-to-fill; }
.fx-flash { position: absolute; left: 0; top: 0; right: 0; bottom: 0; opacity: 0; -unity-background-scale-mode: stretch-to-fill; }
.fx-glitch { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; }
.fx-glitch-bar { position: absolute; }
.fx-slam { position: absolute; left: 0; right: 0; top: 30%; -unity-text-align: middle-center; font-size: 56px; letter-spacing: 8px; text-shadow: 0 0 14px rgba(255, 190, 90, 0.9); }

/* HudStage boards: .mobile (844 x 390) or .desktop (1440 x 900); .only-mobile / .only-desktop blocks show on one board alone. */
.desktop .only-mobile, .mobile .only-desktop { display: none; }
